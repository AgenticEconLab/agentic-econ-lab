# =============================================================================
# AEL (Agentic Econ Lab) environment template
# =============================================================================
# From the repository root, copy this file to .env and fill in what you use:
#   cp .env.example .env
# Every variable below is read by the code at tag v0.7.3. All are optional
# except an LLM endpoint (section 1). Open/local options come first; commercial
# services are fallbacks. Do not commit a filled-in .env.
# Reference: README.md.
# =============================================================================

# =============================================================================
# 1. LLM ENDPOINT (open-weight first)
# =============================================================================
# AEL_MODEL overrides the per-stage models in ael_config.yaml for every
# agent. Without it, ael_config.yaml's default_model (gpt-4o-mini, OpenAI) applies.
#   AEL_MODEL=vllm/qwen3.6-27b-fp8     # Layer 1: vLLM server (HPC); name = --served-model-name
#   AEL_MODEL=ollama/qwen3-32b         # Layer 2: local Ollama (laptop)
#   AEL_MODEL=gpt-4o-mini              # Layer 3: commercial fallback (needs its key below)
# AEL_MODEL=

# vLLM chat-completions URL (full path, not just the host).
# VLLM_BASE_URL=http://localhost:11434/v1/chat/completions

# Several vLLM servers at once (used by the HITL committee): served-name=url,...
# AEL_VLLM_ENDPOINTS=gpt-oss-20b=http://localhost:11436/v1/chat/completions,phi-4-mini=http://localhost:11435/v1/chat/completions

# Ollama address used for the reachability check.
# OLLAMA_HOST=http://localhost:11434

# Per-call HTTP timeout in seconds (default 600).
# AEL_LLM_TIMEOUT=600

# 1 = send chat_template_kwargs{enable_thinking:false}. Applied only to vllm/ or
# ollama/ models whose name contains "qwen". Leave unset (or 0) for Mistral, Gemma
# and gpt-oss: their templates reject or lack the kwarg.
# AEL_DISABLE_THINKING=1

# Completion cap and server context length (defaults 8192 / 16384).
# AEL_MAX_TOKENS=8192
# VLLM_MAX_MODEL_LEN=16384

# Parallel workers for per-item LLM loops (default 8).
# AEL_LLM_CONCURRENCY=8

# Alternative per-stage model file (default ael_config.yaml).
# AEL_MODEL_CONFIG=

# Tier-2 evaluation judge (default vllm/mistral-small-3.2-24b-fp8).
# AEL_JUDGE_MODEL=vllm/mistral-small-3.2-24b-fp8

# --- Commercial LLM keys (fallback; only the provider you name in AEL_MODEL) ---
# Needed only for the provider that AEL_MODEL (or default_model) names; a local model
# (vllm/..., ollama/...) needs none. Each key is sent only to its own provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=                  # Gemini models
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
GROQ_API_KEY=

# =============================================================================
# 2. HUMAN-IN-THE-LOOP RESOLUTION
# =============================================================================
# interactive (person at the console; default for standalone team runs)
# auto        (canned defaults; infrastructure smoke tests)
# llm_economist (3-model committee; default for run_ael_pipeline.py)
# AEL_HITL_MODE=llm_economist
# AUTO_HITL_MODE=false             # legacy: true selects auto when AEL_HITL_MODE is unset
# AUTO_HITL_TIMEOUT=120            # seconds an interactive prompt waits

# Committee members (default vllm/gpt-oss-20b,vllm/phi-4-mini,vllm/olmo-3.1-32b-instruct).
# AEL_HITL_COMMITTEE=
# AEL_HITL_LENSES=1                # 0 = members review without distinct economist lenses
# AEL_HITL_MAX_ROUNDS=3
# AEL_HITL_LOG=./hitl_committee_ballots.jsonl   # the pipeline sets <output-dir>/hitl_committee_ballots.jsonl

# =============================================================================
# 3. PIPELINE SWITCHES
# =============================================================================
# AEL_CODE_TEAM_ENABLED=1          # include CodeTeam in run_ael_pipeline.py (off by default)
# AEL_FEASIBILITY_LOOP=0           # skip the Model<->Data loop (on by default)
# AEL_SIMULATION_ENABLED=1         # run ModelTeam 4-SimulationStage
# AEL_PIPELINE_SIGNING_KEY=        # HMAC key for inter-team artifacts (default: random per run)
# Feature flags in ael_config.yaml can be overridden as AEL_<FLAG_NAME_UPPER>, e.g.
# AEL_FALSIFIER_ENABLED=0

# =============================================================================
# 4. WEB CRAWL AND SEARCH (WithWc modes; open providers first)
# =============================================================================
# Crawl chain: WEBCRAWL_PROVIDER, then WEBCRAWL_FALLBACK_CHAIN (empty by default).
# Providers: trafilatura, crawl4ai, tavily, firecrawl, jina.
# WEBCRAWL_PROVIDER=trafilatura
# WEBCRAWL_FALLBACK_CHAIN=crawl4ai,tavily,firecrawl
# WEBCRAWL_TIMEOUT=60              # seconds per provider call

# crawl4ai runs in-process (Playwright/Chromium) unless a server URL is given.
# CRAWL4AI_BASE_URL=http://localhost:11235
# CRAWL4AI_API_KEY=

# Search chain (fixed order): SearXNG -> DDGS (no key) -> Tavily -> Brave.
# SEARXNG_BASE_URL=http://localhost:8899

# --- Commercial crawl/search (fallback) ---
TAVILY_API_KEY=                  # search + crawl
BRAVE_API_KEY=                   # search
FIRECRAWL_API_KEY=               # crawl
JINA_API_KEY=                    # crawl (works rate-limited without a key)
SERPER_API_KEY=                  # Google results via serper.dev (web_search tool)

# =============================================================================
# 5. LITERATURE (LiteratureTeam, IdeationTeam)
# =============================================================================
# OpenAlex: primary source with abstracts. Free key at openalex.org/settings/api;
# keyless use is throttled to about 100 searches a day.
OPENALEX_API_KEY=
# OPENALEX_MAILTO=you@example.org

# Abstract cascade: OpenAlex -> ABSTRACT_CACHE -> Elsevier API.
# See README.md, "Literature abstracts".
# ABSTRACT_CACHE=/path/abstracts.csv   # your licensed DOI->abstract CSV
# ABSTRACT_CACHE_DOI_COL=doi           # column overrides if not auto-detected
# ABSTRACT_CACHE_ABS_COL=abstract
# ELSEVIER_API_KEY=                    # a key alone has worked from the HPC nodes
# ELSEVIER_INSTTOKEN=                  # optional institutional token for off-network use
# ELSEVIER_PROXY=                      # optional HTTP(S) proxy for Elsevier requests

# Semantic Scholar: keyless works; a key raises rate limits.
# SEMANTIC_SCHOLAR_API_KEY=
# S2_API_KEY=
# S2_MIN_INTERVAL=1.1                  # seconds between Semantic Scholar calls

# ELICIT_API_KEY=

# =============================================================================
# 6. DATA (DataTeam)
# =============================================================================
# FRED: free key at fred.stlouisfed.org. Without it FRED series are simulated and
# flagged data_simulated. World Bank, DBnomics, OECD, IMF, BIS, ECB, Eurostat, BLS
# and yfinance need no key.
FRED_API_KEY=
# AEL_DATA_APIS=FRED,World Bank,BLS,Census   # source list passed by the pipeline runner
# AEL_DATA_MIN_OBS=20                        # minimum observations per series
# AEL_PROVIDER_SEARCH=1                      # 0 = no online series lookup

# --- Premium (ModePremiumSubscribed) ---
# A vendor counts as available only if its variables are set AND a local terminal
# is detected (Eikon proxy, Bloomberg session) or the operator opts in below.
# On hosts without a terminal (e.g. HPC nodes) the mode reports N/A.
# REFINITIV_EIKON_API_KEY=
# BLOOMBERG_API_KEY=
# WRDS_USERNAME=
# WRDS_PASSWORD=
# ALPHA_VANTAGE_API_KEY=           # Alpha Vantage client (shared/data/alpha_vantage.py)
# PREMIUM_TERMINAL_VERIFIED=1      # set only on a host with a logged-in terminal
# (vendor-specific form: REFINITIV_TERMINAL_VERIFIED, BLOOMBERG_TERMINAL_VERIFIED, WRDS_TERMINAL_VERIFIED)

# =============================================================================
# 7. CONSOLE OUTPUT
# =============================================================================
# AEL_VERBOSE=true
# AGENT_QUIET_MODE=true
