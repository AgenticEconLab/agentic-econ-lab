logs/
evaluation/_unparseable_responses/

# Telemetry
otel_traces.json

# Large binary files
*.mp3
*.whl

# Runtime memory DBs (auto-recreated at runtime; never ship)
*.db
*.sqlite*
memory/long_term/
memory/episodic/
memory/short_term/

